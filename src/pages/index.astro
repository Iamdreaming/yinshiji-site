---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products, collections } from '../data/products';
import { siteLinks } from '../data/site-links';

const taobaoUrl = siteLinks.taobao;

const alternateLinks = [
  { lang: 'en', href: '/' },
  { lang: 'zh-CN', href: '/zh/' },
  { lang: 'x-default', href: '/' },
];

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '/guide', label: 'Guide' },
  { href: '/reference', label: 'Reference' },
  { href: '/about', label: 'About' },
  { href: '/materials-care', label: 'Materials & Care' },
  { href: '/faq', label: 'FAQ' },
];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Yinshiji',
  alternateName: ['银食记', 'Tableorie'],
  url: 'https://tableorie.com/',
  description:
    'Early-stage Chinese-inspired tableware brand focused on carved stainless steel cutlery and wenge wood handle cutlery, rooted in Jieyang, Guangdong supply-chain proximity.',
  areaServed: 'China',
  knowsAbout: [
    'stainless steel cutlery',
    '304 stainless steel tableware',
    '410 stainless steel knives',
    'wenge wood handle cutlery',
    'Chinese-inspired tableware',
  ],
  sameAs: [
    taobaoUrl,
    'https://www.xiaohongshu.com/search_result?keyword=%E9%93%B6%E9%A3%9F%E8%AE%B0',
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Yinshiji / Tableorie',
  url: 'https://tableorie.com/',
  inLanguage: 'en',
  description: 'Lightweight brand, product, material-care, and guide site for Yinshiji tableware.',
};
---

<BaseLayout
  title="Yinshiji – Chinese Inspired Tableware | Stainless Steel Cutlery"
  description="Yinshiji (Silver Food Records) offers Chinese-inspired carved and wenge wood handle cutlery — stainless steel flatware sets and single pieces with clear material notes. Curated batch products."
  ogType="website"
  lang="en"
  homeUrl="/"
  navItems={navItems}
  alternateLinks={alternateLinks}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
  </Fragment>

  <section class="hero">
    <div class="container">
      <div class="hero-surface">
        <div class="hero-grid">
          <div class="hero-copy">
            <div class="eyebrow hero-animate-eyebrow">From Jieyang, for your table</div>
            <h1 class="hero-animate-title">Carved stainless steel cutlery for your table</h1>
            <p class="hero-animate-body">
              We make carved stainless steel cutlery and wenge wood handle tableware — single pieces
              and full sets, from Jieyang to your table. No luxury stories. Just honest materials
              and details worth keeping.
            </p>
            <div class="hero-cta hero-animate-cta">
              <a href="/products" class="btn btn-primary btn-ripple">Browse Products</a>
              <a href="/guide" class="btn btn-outline btn-ripple">Read the Choosing Guide</a>
              <a href={siteLinks.taobao} class="btn btn-outline btn-ripple" target="_blank" rel="noopener noreferrer nofollow">Taobao Store</a>
              <a href="/about" class="btn btn-outline btn-ripple">Our Story</a>
            </div>
            <div class="hero-meta hero-animate-meta" data-stagger-children>
              <div class="hero-meta-card reveal">
                <strong>Material</strong>
                <span>Fork/spoon pieces: 304 stainless steel. Carved-set knives: 410. Gold-tone finish and wenge wood handles explained upfront.</span>
              </div>
              <div class="hero-meta-card reveal">
                <strong>Stage</strong>
                <span>Early-stage brand — product info is transparent, not dressed up with fake reviews or inventory.</span>
              </div>
              <div class="hero-meta-card reveal">
                <strong>Use</strong>
                <span>Single pieces and complete place settings for daily tables.</span>
              </div>
            </div>
          </div>
          <div class="hero-visual" aria-hidden="true">
            <div class="hero-visual-card hero-animate-img">
              <img src="/images/products/collection-gold-carved.webp" alt="Gold Tone Carved Collection — Yinshiji stainless steel cutlery" loading="eager" decoding="async" width="1254" height="1254" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section content-band">
    <div class="container">
      <div class="statement-panel reveal">
        <div class="eyebrow reveal stagger-1">Why Yinshiji</div>
        <h2 class="section-title section-title-reveal reveal stagger-2">Good cutlery at an honest price</h2>
        <p class="reveal stagger-3">
          Yinshiji selects well-made tableware from a manufacturing region that knows stainless steel.
          The three collections share the same foundation — clear steel grades, intentional detail, everyday use —
          but each brings a different mood to the table. Honest tableware that looks
          and feels like it belongs.
        </p>
        <div class="mini-card-grid" data-stagger-children>
          <div class="mini-card reveal">
            <strong>From the source</strong>
            <span>We select from Jieyang, a region with real stainless steel tableware manufacturing. We compare, pick, and keep the pieces that hold up.</span>
          </div>
          <div class="mini-card reveal">
            <strong>By the grade</strong>
            <span>Material is listed by SKU: carved-set knives use 410 stainless steel; fork and spoon pieces use 304. Gold-tone and wenge wood care are stated upfront.</span>
          </div>
          <div class="mini-card reveal">
            <strong>In batches</strong>
            <span>Products come in batches. Availability can shift — the site reflects current batch status.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title section-title-reveal reveal">Which Collection Fits Your Table?</h2>
      <p class="section-subtitle reveal stagger-2">
        The three collections are not just color variants. Each one carries a different table mood and use case.
      </p>
      <table class="comparison-table reveal stagger-3">
        <thead>
          <tr>
            <th>Collection</th>
            <th>Table mood</th>
            <th>Best fit</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Silver Carved</strong></td>
            <td>Clean, classic, detailed without feeling heavy.</td>
            <td>Daily refined table, first set, neutral interiors.</td>
          </tr>
          <tr>
            <td><strong>Gold Tone Carved</strong></td>
            <td>Warmer, more decorative, more visible on the table.</td>
            <td>Hosting, gifting, festive meals, warm lighting.</td>
          </tr>
          <tr>
            <td><strong>Wenge Wood Handle</strong></td>
            <td>Natural, tactile, more Chinese-home friendly.</td>
            <td>One-person dining, bowls, chopsticks, office meals.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section" style="background: #fff;">
    <div class="container">
      <h2 class="section-title section-title-reveal reveal">Our Collections</h2>
      <p class="section-subtitle reveal stagger-2">
        Three distinct collections, each defined by its materials and design language.
      </p>
      <div class="product-grid" data-stagger-children>
        {collections.map((col) => (
          <div class="product-card tilt-card reveal">
            <div class="product-card-img">
              <img src={col.image} alt={`${col.name} promotional poster`} loading="eager" decoding="async" width="1254" height="1254" />
            </div>
            <div class="product-card-body">
              <h3>{col.name}</h3>
              <p>{col.description}</p>
              <div class="product-card-actions">
                <a href="/products" class="btn btn-outline" style="font-size:0.85rem; padding:0.4rem 1.2rem;">
                  View Collection
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title section-title-reveal reveal">Featured Products</h2>
      <p class="section-subtitle reveal stagger-2">
        Our full sets are a complete place setting; single pieces let you build your own collection.
      </p>
      <div class="featured-grid" data-stagger-children>
        {products.slice(0, 4).map((p) => (
          <div class="product-card tilt-card reveal">
            <div class="product-card-img">
              {p.imagePlaceholder.startsWith('/images/products/') ? (
                <img src={p.imagePlaceholder} alt={`${p.name} by Yinshiji`} loading="eager" decoding="async" width="1254" height="1254" />
              ) : (
                <span style="opacity: 0.4;">[ {p.name} ]</span>
              )}
            </div>
            <div class="product-card-body">
              <span class="tag">{p.category === 'set' ? '5-Piece Set' : 'Single Piece'}</span>
              <h3>{p.name}</h3>
              <p>{p.tagline}</p>
              <div class="product-card-actions">
                <a href={`/products/${p.slug}`} class="btn btn-outline" style="font-size:0.85rem; padding:0.4rem 1.2rem;">
                  View Details
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center; margin-top:2rem;" class="reveal">
        <a href="/products" class="btn btn-primary btn-ripple">See All Products</a>
      </div>
    </div>
  </section>

  <section class="section" style="background: #fff;">
    <div class="container">
      <h2 class="section-title section-title-reveal reveal">Why Yinshiji?</h2>
      <div class="trust-grid" data-stagger-children>
        <div class="trust-card reveal">
          <h3>Chinese Inspired Design</h3>
          <p>
            Carving is not decoration for its own sake. It is a quiet way to let Chinese pattern
            language show up at an everyday table.
          </p>
        </div>
        <div class="trust-card reveal">
          <h3>Premium Materials</h3>
          <p>
            Each product page states its real material grade — from 304 fork and spoon pieces to 410 carved-set knives — so the details stay honest.
            Wenge wood handles are selected for their natural chicken-wing grain and warm hand feel.
          </p>
        </div>
        <div class="trust-card reveal">
          <h3>Close to Jieyang's Supply Chain</h3>
          <p>
            Yinshiji grows from Jieyang, Guangdong — a practical stainless steel tableware and hardware
            manufacturing region. That closeness helps us compare materials, finishes, and production
            details more directly.
          </p>
        </div>
                <div class="trust-card reveal">
          <h3>Batch Transparency</h3>
          <p>Products are produced in curated batches. Each product page states material, composition, and care notes honestly, and availability is confirmed per batch.</p>
        </div>
  </section>
</BaseLayout>
