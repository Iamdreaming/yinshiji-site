---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guideArticles } from '../../data/geo-guides';

export function getStaticPaths() {
  return guideArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const site = Astro.site ?? new URL('https://tableorie.com');
const pagePath = `/guide/${article.slug}`;
const pageUrl = new URL(pagePath, site).href;

const alternateLinks = [
  { lang: 'en', href: pagePath },
  { lang: 'zh-CN', href: `/zh/guide/${article.slug}` },
  { lang: 'x-default', href: pagePath },
];

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '/guide', label: 'Guide' },
  { href: '/reference', label: 'Reference' },
  { href: '/about', label: 'About' },
  { href: '/materials-care', label: 'Materials & Care' },
  { href: '/faq', label: 'FAQ' },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Organization', name: 'Yinshiji' },
  publisher: { '@type': 'Organization', name: 'Yinshiji', url: new URL('/', site).href },
  inLanguage: 'en',
  about: ['tableware', 'flatware', 'stainless steel cutlery', 'Chinese-inspired tableware'],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: article.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Guide', item: new URL('/guide', site).href },
    { '@type': 'ListItem', position: 3, name: article.title, item: pageUrl },
  ],
};
---

<BaseLayout
  title={`${article.title} – Yinshiji Guide`}
  description={article.description}
  canonical={pagePath}
  ogType="article"
  lang="en"
  homeUrl="/"
  navItems={navItems}
  alternateLinks={alternateLinks}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="section" style="padding-top:3rem;">
    <div class="container">
      <nav style="font-size:0.85rem; color:var(--color-text-muted); margin-bottom:2rem;">
        <a href="/guide">Guide</a>
        <span style="margin:0 0.5rem;">/</span>
        <span>{article.eyebrow}</span>
      </nav>

      <article class="prose" style="max-width:860px; margin:0 auto;">
        <p class="eyebrow">{article.eyebrow}</p>
        <h1 style="font-family:var(--font-serif); font-size:clamp(2.2rem, 5vw, 3.7rem); line-height:1.05; margin:0.4rem 0 1rem;">
          {article.title}
        </h1>
        <p style="font-size:1.12rem; color:var(--color-text-muted); max-width:760px;">
          {article.description}
        </p>

        <section class="statement-panel" style="margin-top:2rem;">
          <h2 style="font-size:1.35rem; margin-bottom:0.7rem;">Quick answer</h2>
          <p>{article.quickAnswer}</p>
        </section>

        {article.sections.map((section) => (
          <section class="detail-section">
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul class="feature-list" style="margin-top:1rem;">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </section>
        ))}

        <section class="detail-section">
          <h2>Questions this page answers</h2>
          <div class="faq-list">
            {article.faqs.map((item) => (
              <article class="faq-item">
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="detail-section">
          <h2>Related pages</h2>
          <div style="display:flex; gap:0.8rem; flex-wrap:wrap;">
            {article.relatedLinks.map((link) => (
              <a href={link.href} class="btn btn-outline">{link.label}</a>
            ))}
          </div>
        </section>
      </article>
    </div>
  </section>
</BaseLayout>
