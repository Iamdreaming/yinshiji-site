---
import BaseLayout from '../layouts/BaseLayout.astro';

const alternateLinks = [
  { lang: 'en', href: '/manufacturing' },
  { lang: 'zh-CN', href: '/zh/manufacturing' },
  { lang: 'x-default', href: '/manufacturing' },
];
---

<BaseLayout
  title="Yinshiji Tableware — Crafted in Jieyang, China"
  description="Yinshiji cutlery is made in Jieyang, China's stainless steel capital — carved stainless steel and wenge wood handle flatware. Our craft story, materials, and honest quality status."
  canonical="/manufacturing"
  ogType="website"
  lang="en"
  homeUrl="/"
  alternateLinks={alternateLinks}
>
  <section class="section" style="padding-top:3rem;">
    <div class="container">
      <h1 class="section-title">Our Craft</h1>

      <div class="prose">
        <p class="lead" style="font-size:1.15rem; line-height:1.7; max-width:760px;">
          <strong>Yinshiji</strong> flatware is crafted in <strong>Jieyang, Guangdong</strong> —
          the stainless steel capital of China, where the country's cutlery industry was born.
          We combine carved stainless steel with wenge wood handles for mid-to-high-end
          differentiated tableware.
        </p>

        <h2>Origin: Jieyang, China's Stainless Steel Capital</h2>
        <p>
          Jieyang has been the center of China's stainless steel tableware industry for decades,
          with a dense cluster of material suppliers, stamping and forging shops, and finishing
          workshops. Being based here means shorter communication with the production line,
          faster sampling cycles, and direct control over material grade and surface finish.
        </p>

        <h2>Process Capabilities</h2>
        <ul>
          <li><strong>Carved engraving</strong> — our signature carved motifs on fork, spoon, and knife handles (silver and gold tone finishes; gold tone is a finish, not real gold).</li>
          <li><strong>Wenge wood handle assembly</strong> — natural wenge wood handles paired with stainless steel heads, for a warm Chinese-Western hybrid look.</li>
          <li><strong>Steel grades</strong> — fork/spoon heads in 304 food-grade stainless steel; carved knives in 410 (hardened for cutting performance). Stated honestly, not as a marketing claim.</li>
          <li><strong>Custom molds</strong> — new shapes, logos, and packaging, developed in-house.</li>
        </ul>

        <h2>Quality Status — Honest Note</h2>
        <p>
          Independent <strong>SGS testing is pending</strong> at this time. We do not claim a
          certification that has not been issued. Materials are specified honestly (304 / 410 steel
          grades, real wenge wood), and we will publish test results as soon as they are available.
        </p>

        <div style="text-align:center; margin:2.5rem 0 1rem;">
          <a href="/contact" class="btn btn-primary" style="padding:0.7rem 2.5rem; font-size:1rem;">
            Get in Touch
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
