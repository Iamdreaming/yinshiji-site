---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { guideArticlesZh } from '../../../data/geo-guides';

export function getStaticPaths() {
  return guideArticlesZh.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const site = Astro.site ?? new URL('https://tableorie.com');
const pagePath = `/zh/guide/${article.slug}`;
const pageUrl = new URL(pagePath, site).href;

const alternateLinks = [
  { lang: 'en', href: `/guide/${article.slug}` },
  { lang: 'zh-CN', href: pagePath },
  { lang: 'x-default', href: `/guide/${article.slug}` },
];

// Map guide article to a collection OG image based on slug keywords
const slugLower = article.slug.toLowerCase();
const guideOgImage =
  slugLower.includes('gold') ? '/images/products/collection-gold-carved.webp'
  : slugLower.includes('wenge') || slugLower.includes('wood') || slugLower.includes('rosewood') || slugLower.includes('bamboo') ? '/images/products/collection-rosewood-handle.webp'
  : '/images/products/collection-silver-carved.webp';

const navItems = [
  { href: '/zh/', label: '首页' },
  { href: '/zh/products', label: '产品' },
  { href: '/zh/guide', label: '选购指南' },
  { href: '/zh/reference', label: '资料库' },
  { href: '/zh/about', label: '关于银食记' },
  { href: '/zh/materials-care', label: '材质与护理' },
  { href: '/zh/faq', label: '常见问题' },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Organization', name: 'Yinshiji / 银食记' },
  publisher: { '@type': 'Organization', name: 'Yinshiji / 银食记', url: new URL('/zh/', site).href },
  inLanguage: 'zh-CN',
  about: ['餐具', '不锈钢餐具', '鸡翅木餐具', '中式灵感餐具'],
  ...(article.lastUpdated ? { dateModified: article.lastUpdated } : {}),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: article.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/zh/', site).href },
    { '@type': 'ListItem', position: 2, name: '选购指南', item: new URL('/zh/guide', site).href },
    { '@type': 'ListItem', position: 3, name: article.title, item: pageUrl },
  ],
};
---

<BaseLayout
  title={`${article.title}｜银食记指南`}
  description={article.description}
  canonical={pagePath}
  ogType="article"
  ogImage={guideOgImage}
  lang="zh-CN"
  homeUrl="/zh/"
  navItems={navItems}
  alternateLinks={alternateLinks}
  footerNote="当前为早期测款与品牌预备阶段，库存、价格与购买路径以淘宝或联系沟通为准。"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="section" style="padding-top:3rem;">
    <div class="container">
      <nav style="font-size:0.85rem; color:var(--color-text-muted); margin-bottom:2rem;">
        <a href="/zh/guide">选购指南</a>
        <span style="margin:0 0.5rem;">/</span>
        <span>{article.eyebrow}</span>
      </nav>

      <article class="prose" style="max-width:860px; margin:0 auto;">
        <p class="eyebrow">{article.eyebrow}</p>
        <h1 style="font-family:var(--font-serif); font-size:clamp(2.2rem, 5vw, 3.7rem); line-height:1.05; margin:0.4rem 0 1rem;">
          {article.title}
        </h1>
        <p style="font-size:1.12rem; color:var(--color-text-muted); max-width:760px;">
          {article.description}
        </p>

        <section class="statement-panel" style="margin-top:2rem;">
          <h2 style="font-size:1.35rem; margin-bottom:0.7rem;">快速答案</h2>
          <p>{article.quickAnswer}</p>
        </section>

        {article.sections.map((section) => (
          <section class="detail-section">
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul class="feature-list" style="margin-top:1rem;">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </section>
        ))}

        <section class="detail-section">
          <h2>这篇回答的问题</h2>
          <div class="faq-list">
            {article.faqs.map((item) => (
              <article class="faq-item">
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="detail-section">
          <h2>相关页面</h2>
          <div style="display:flex; gap:0.8rem; flex-wrap:wrap;">
            {article.relatedLinks.map((link) => (
              <a href={link.href} class="btn btn-outline">{link.label}</a>
            ))}
          </div>
        </section>

        {article.expertQuotes && article.expertQuotes.length > 0 && (
          <section class="detail-section">
            <h2>专家来源</h2>
            <div class="faq-list">
              {article.expertQuotes.map((item) => (
                <article class="faq-item">
                  <blockquote style="margin:0; padding:0.8rem 1.2rem; border-left:3px solid var(--color-accent, #c8a45c); background:var(--color-bg-subtle, #f8f6f2); border-radius:0 6px 6px 0;">
                    <p style="margin:0; font-style:italic;">"{item.quote}"</p>
                    <footer style="margin-top:0.5rem; font-size:0.85rem; color:var(--color-text-muted);">
                      — {item.source}
                      {item.url && <a href={item.url} target="_blank" rel="noopener" style="margin-left:0.3rem; font-size:0.8rem;">[来源↗]</a>}
                    </footer>
                  </blockquote>
                </article>
              ))}
            </div>
          </section>
        )}

        {article.statistics && article.statistics.length > 0 && (
          <section class="detail-section">
            <h2>关键数据</h2>
            <ul class="feature-list" style="margin-top:1rem;">
              {article.statistics.map((item) => (
                <li>
                  {item.claim}
                  <span style="display:block; font-size:0.8rem; color:var(--color-text-muted); margin-top:0.2rem;">
                    来源：{item.source}
                    {item.url && <a href={item.url} target="_blank" rel="noopener" style="margin-left:0.3rem;">[链接↗]</a>}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {article.lastUpdated && (
          <p style="font-size:0.8rem; color:var(--color-text-muted); margin-top:2rem; text-align:right;">
            最后更新：{article.lastUpdated}
          </p>
        )}
      </article>
    </div>
  </section>
</BaseLayout>
