---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteLinks } from '../../data/site-links';

const alternateLinks = [
  { lang: 'en', href: '/faq' },
  { lang: 'zh-CN', href: '/zh/faq' },
  { lang: 'x-default', href: '/faq' },
];

const navItems = [
  { href: '/zh/', label: '首页' },
  { href: '/zh/products', label: '产品' },
  { href: '/zh/guide', label: '选购指南' },
  { href: '/zh/reference', label: '资料库' },
  { href: '/zh/about', label: '关于银食记' },
  { href: '/zh/materials-care', label: '材质与护理' },
  { href: '/zh/faq', label: '常见问题' },
];

const faqs = [
  {
    q: '银食记现在的产品都是 304 不锈钢吗？',
    a: '不是。每个 SKU 页面会标明具体材质。当前雕花五件套中，餐刀为 410 不锈钢，主叉、主勺、小叉、小勺为 304 不锈钢；单支主叉仍为 304 不锈钢。如果后续批次材质或表面处理发生变化，应该先更新页面再销售。',
  },
  {
    q: '金色雕花是真金或镀金吗？',
    a: '不是。这里的金色指表面色调和视觉效果，不是真金，也不是贵金属属性。页面会明确说明这一点，避免误导。',
  },
  {
    q: '鸡翅木手柄怎么保养？',
    a: '建议手洗，不要长时间浸泡，清洗后及时擦干。木柄天然纹理每支会有差异，必要时可少量使用食品级木器保养油维护手感。',
  },
  {
    q: '可以放洗碗机吗？',
    a: '为了长期保持表面状态，建议手洗。鸡翅木手柄产品不建议进入洗碗机。纯金属款也建议使用温和清洁方式并及时擦干。',
  },
  {
    q: '现在怎么购买银食记产品？',
    a: '国内用户可在商品可售时通过淘宝店购买。如需确认当前批次库存、拿样、批发或合作，建议先直接联系确认。',
  },
  {
    q: '支持批发或拿样吗？',
    a: '可以。请先说明目标数量、产品系列、用途和期望时间，可确认当前批次和供应情况。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title="常见问题｜银食记"
  description="银食记常见问题：不锈钢钢种、金色表面、鸡翅木护理、洗碗机、购买方式、拿样和批发合作。"
  canonical="/zh/faq"
  ogType="website"
  lang="zh-CN"
  homeUrl="/zh/"
  navItems={navItems}
  alternateLinks={alternateLinks}
  footerNote="当前批次 — 库存、价格与购买以淘宝或直接沟通为准。"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="section" style="padding-top:3rem;">
    <div class="container">
      <h1 class="section-title">常见问题</h1>
      <p class="section-subtitle">
        把材质、护理、购买方式和供应状态说清楚。银食记目前以批次供应，信息透明比包装成熟更重要。
      </p>
      <div class="faq-list">
        {faqs.map((item) => (
          <article class="faq-item">
            <h2>{item.q}</h2>
            <p>{item.a}</p>
          </article>
        ))}
      </div>
      <div class="statement-panel" style="margin-top:2rem;">
        <h2 class="section-title" style="font-size:1.5rem;">对这组系列感兴趣？</h2>
        <p>产品按批次供应。淘宝店是当前国内购买和咨询入口。</p>
        <div style="margin-top:1rem;">
          <a href={siteLinks.taobao} class="btn btn-primary" target="_blank" rel="noopener noreferrer nofollow">前往淘宝店</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
