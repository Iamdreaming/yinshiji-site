---
import BaseLayout from '../../layouts/BaseLayout.astro';

const alternateLinks = [
  { lang: 'en', href: '/manufacturing' },
  { lang: 'zh-CN', href: '/zh/manufacturing' },
  { lang: 'x-default', href: '/manufacturing' },
];

const navItems = [
  { href: '/zh/', label: '首页' },
  { href: '/zh/products', label: '产品' },
  { href: '/zh/guide', label: '选购指南' },
  { href: '/zh/reference', label: '资料库' },
  { href: '/zh/about', label: '关于银食记' },
  { href: '/zh/materials-care', label: '材质与护理' },
  { href: '/zh/manufacturing', label: '我们的工艺' },
  { href: '/zh/faq', label: '常见问题' },
];
---

<BaseLayout
  title="我们的工艺｜银食记"
  description="银食记餐具产自揭阳——中国不锈钢之都。雕花不锈钢与鸡翅木餐具，我们的工艺故事、材质与诚实的质检状态。"
  canonical="/zh/manufacturing"
  ogType="website"
  lang="zh-CN"
  homeUrl="/zh/"
  navItems={navItems}
  alternateLinks={alternateLinks}
  footerNote=""
>
  <section class="section" style="padding-top:3rem;">
    <div class="container">
      <h1 class="section-title">我们的工艺</h1>

      <div class="prose">
        <p class="lead" style="font-size:1.15rem; line-height:1.7; max-width:760px;">
          <strong>银食记</strong>餐具产自<strong>广东揭阳</strong>——中国不锈钢之都，
          中国餐具产业发源地。我们把雕花不锈钢与鸡翅木工艺结合，做中高端差异化餐具。
        </p>

        <h2>产地：揭阳，中国不锈钢之都</h2>
        <p>
          揭阳数十年来一直是中国不锈钢餐具产业的中心：材料供应商、冲压锻造厂、表面处理
          作坊高度聚集。产地直连意味着与生产线的沟通更短、打样周期更快、
          对材质等级和表面质量的把控更直接。
        </p>

        <h2>工艺能力</h2>
        <ul>
          <li><strong>雕花工艺</strong>——银食记标志性的刀、叉、勺柄雕花（银色与金色饰面；金色为饰面工艺，非真金）。</li>
          <li><strong>鸡翅木拼接</strong>——天然鸡翅木柄与不锈钢头拼接，温润的中西融合日用感。</li>
          <li><strong>钢级</strong>——叉/勺为 304 食品级不锈钢；雕花刀为 410（淬火硬化保证切削性）。如实标注，不作营销话术。</li>
          <li><strong>开模定制</strong>——新造型、Logo、包装的自主开发。</li>
        </ul>

        <h2>质检状态——如实说明</h2>
        <p>
          独立 <strong>SGS 检测目前进行中（pending）</strong>。我们不会声称尚未取得的认证。
          材质如实标注（304 / 410 钢级、真鸡翅木），检测结果出炉后会第一时间公布。
        </p>

        <div style="text-align:center; margin:2.5rem 0 1rem;">
          <a href="/zh/contact" class="btn btn-primary" style="padding:0.7rem 2.5rem; font-size:1rem;">
            联系我们
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
