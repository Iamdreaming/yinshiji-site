---
import { siteLinks } from '../data/site-links';
export interface AlternateLink {
  lang: string;
  href: string;
}

export interface NavItem {
  href: string;
  label: string;
}

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  lang?: string;
  homeUrl?: string;
  navItems?: NavItem[];
  alternateLinks?: AlternateLink[];
  footerNote?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  lang = 'en',
  homeUrl = '/',
  navItems = [
    { href: '/', label: 'Home' },
    { href: '/products', label: 'Products' },
  { href: '/guide', label: 'Guide' },
  { href: '/reference', label: 'Reference' },
  { href: '/about', label: 'About' },
    { href: '/materials-care', label: 'Materials & Care' },
    { href: '/faq', label: 'FAQ' },
  ],
  alternateLinks = [],
  footerNote = 'Early-stage brand — contact us for product availability and wholesale inquiries.',
} = Astro.props;

const site = Astro.site ?? new URL('https://tableorie.com');
const rawCanonical = canonical ? new URL(canonical, site).href : new URL(Astro.url.pathname, site).href;
// Ensure trailing slash consistency (Astro trailingSlash: 'always')
const canonicalUrl = rawCanonical.endsWith('/') ? rawCanonical : rawCanonical + '/';
const defaultOgImage = '/og-default.png';
const logoText = lang === 'zh-CN' ? '银食记' : 'Yinshiji';
const logoSubText = lang === 'zh-CN' ? 'Yinshiji' : '银食记';
const shopLinkLabel = lang === 'zh-CN' ? '淘宝店' : 'Taobao';
const footerLinks = navItems.slice(1);
const englishLink = alternateLinks.find((link) => link.lang === 'en');
const chineseLink = alternateLinks.find((link) => link.lang === 'zh-CN');
const languageLinks = [
  englishLink && { ...englishLink, label: 'EN', isActive: lang === 'en' },
  chineseLink && { ...chineseLink, label: '中文', isActive: lang === 'zh-CN' },
].filter(Boolean) as Array<AlternateLink & { label: string; isActive: boolean }>;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={new URL(link.href, site).href} />
    ))}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType || 'website'} />
    <meta property="og:image" content={new URL(ogImage || defaultOgImage, site).href} />
    <meta property="og:site_name" content="Yinshiji" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="generator" content={Astro.generator} />
    <slot name="head" />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-09MB8B5X2N"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-09MB8B5X2N');
    </script>

    <!-- Umami Analytics -->
    <script defer src="https://umami.crt-blog.top/script.js" data-website-id="ef095731-70f3-4a0e-abde-ba77912838ab"></script>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --color-bg: #f4f0eb;
        --color-text: #1c1917;
        --color-text-muted: #78716c;
        --color-accent: #7c5a3e;
        --color-accent-light: #a6845e;
        --color-accent-deep: #5c3d28;
        --color-border: #d6ccc4;
        --color-card-bg: #ffffff;
        --color-surface-strong: #e7e2db;
        --color-tag-bg: #e0d8d0;
        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-serif: 'EB Garamond', 'Georgia', 'Times New Roman', serif;
        --font-display: var(--font-serif);
        --max-width: 1100px;
        --radius: 8px;
        --radius-large: 18px;
      }

      html {
        font-size: 16px;
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.7;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      a {
        color: var(--color-accent);
        text-decoration: none;
        transition: color 0.2s;
      }
      a:hover {
        color: var(--color-accent-light);
      }

      img {
        max-width: 100%;
        height: auto;
      }

      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.5rem;
        width: 100%;
      }

      .site-header {
        border-bottom: 1px solid var(--color-border);
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .site-header .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 64px;
        gap: 1rem;
      }
      .site-header-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .site-logo {
        font-family: var(--font-serif);
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--color-text);
        letter-spacing: 0.02em;
        white-space: nowrap;
      }
      .site-logo span {
        color: var(--color-accent);
      }
      .site-logo:hover {
        color: var(--color-text);
      }
      .site-nav {
        display: flex;
        gap: 1.2rem;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
      }
      .site-nav a {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--color-text-muted);
        padding: 0.25rem 0;
        border-bottom: 2px solid transparent;
      }
      .site-nav a:hover,
      .site-nav a.active {
        color: var(--color-text);
        border-bottom-color: var(--color-accent);
      }
      .language-switcher {
        display: inline-flex;
        align-items: center;
        gap: 0.18rem;
        padding: 0.18rem;
        border: 1px solid rgba(138, 90, 43, 0.22);
        border-radius: 999px;
        background: rgba(255, 250, 243, 0.78);
        box-shadow: 0 8px 20px rgba(62, 39, 35, 0.04);
      }
      .language-switcher a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.45rem;
        min-height: 1.9rem;
        padding: 0.2rem 0.62rem;
        border-radius: 999px;
        color: var(--color-text-muted);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.02em;
      }
      .language-switcher a:hover {
        color: var(--color-accent-deep);
        background: rgba(230, 215, 196, 0.55);
      }
      .language-switcher a.active {
        color: #fff;
        background: var(--color-accent);
      }
      .shop-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.25rem;
        padding: 0.35rem 0.95rem;
        border-radius: 999px;
        background: var(--color-accent);
        color: #fff;
        font-size: 0.82rem;
        font-weight: 700;
        box-shadow: 0 10px 24px rgba(138, 90, 43, 0.16);
      }
      .shop-link:hover {
        color: #fff;
        background: var(--color-accent-deep);
        transform: translateY(-1px);
      }


      .site-footer {
        margin-top: auto;
        border-top: 1px solid var(--color-border);
        background: #ffffff;
        padding: 2.5rem 0 1.5rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }
      .site-footer .container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .footer-links {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
      }
      .footer-links a {
        color: var(--color-text-muted);
      }
      .footer-links a:hover {
        color: var(--color-accent);
      }
      .footer-copy {
        font-size: 0.8rem;
      }

      .section-title {
        font-family: var(--font-serif);
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--color-text);
      }
      .section-subtitle {
        font-size: 1.05rem;
        color: var(--color-text-muted);
        max-width: 640px;
        margin-bottom: 2rem;
        text-wrap: pretty;
      }

      .btn {
        display: inline-block;
        padding: 0.7rem 1.8rem;
        border-radius: var(--radius);
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        text-align: center;
        box-shadow: 0 10px 24px rgba(62, 39, 35, 0.04);
      }
      .btn-primary {
        background: var(--color-accent);
        color: #fff;
      }
      .btn-primary:hover {
        background: var(--color-accent-light);
        color: #fff;
        transform: translateY(-1px);
      }
      .btn-outline {
        background: rgba(255, 250, 243, 0.72);
        border: 2px solid var(--color-accent);
        color: var(--color-accent);
      }
      .btn-outline:hover {
        background: var(--color-accent);
        color: #fff;
        transform: translateY(-1px);
      }

      .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2rem;
      }
      .featured-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2rem;
      }
      .product-card {
        background: var(--color-card-bg);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-large);
        overflow: hidden;
        transition: box-shadow 0.25s, transform 0.25s, border-color 0.25s;
        display: flex;
        flex-direction: column;
        height: 100%;
      }
      .product-card:hover {
        box-shadow: 0 12px 40px rgba(28, 25, 23, 0.08);
        transform: translateY(-2px);
        border-color: rgba(124, 90, 62, 0.2);
      }
      .product-card-img {
        background: linear-gradient(180deg, #f7f2ea 0%, #efe4d4 100%);
        height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-muted);
        font-size: 0.85rem;
        padding: 1rem;
      }
      .product-card-img img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
      }
      .product-media {
        background: #f0ede8;
        border-radius: var(--radius);
        aspect-ratio: 1 / 1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-muted);
        font-size: 1rem;
        border: 1px solid var(--color-border);
        overflow: hidden;
      }
      .product-media img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
      }
      .product-card-body {
        padding: 1.35rem;
        display: flex;
        flex-direction: column;
        flex: 1;
      }
      .product-card h3 {
        font-family: var(--font-serif);
        font-size: 1.1rem;
        margin-bottom: 0.4rem;
      }
      .product-card .tag,
      .tag {
        display: inline-block;
        font-size: 0.75rem;
        background: var(--color-tag-bg);
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        color: var(--color-accent-deep);
        margin-bottom: 0.6rem;
        margin-right: 0.25rem;
        font-weight: 600;
      }
      .product-card p {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        margin-bottom: 1rem;
      }
      .product-card-actions {
        margin-top: auto;
        padding-top: 0.75rem;
      }

      .hero {
        padding: 4.5rem 0 4rem;
      }
      .hero-surface {
        background: radial-gradient(circle at top left, rgba(124, 90, 62, 0.08), transparent 40%),
          linear-gradient(135deg, rgba(255, 250, 243, 0.98) 0%, rgba(244, 240, 235, 0.98) 100%);
        border: 1px solid rgba(196, 184, 168, 0.7);
        border-radius: 28px;
        padding: 2rem;
        box-shadow: 0 22px 48px rgba(62, 39, 35, 0.08);
      }
      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
        gap: 2rem;
        align-items: center;
      }
      .hero-copy {
        text-align: left;
      }
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 1rem;
        padding: 0.3rem 0.75rem;
        border: 1px solid rgba(138, 90, 43, 0.2);
        border-radius: 999px;
        background: rgba(255, 250, 243, 0.84);
        color: var(--color-accent-deep);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .hero h1 {
        font-family: var(--font-serif);
        font-size: clamp(2.6rem, 4vw, 4.2rem);
        font-weight: 700;
        margin-bottom: 1rem;
        line-height: 1.08;
        max-width: 10ch;
      }
      .hero p {
        font-size: 1.15rem;
        color: var(--color-text-muted);
        max-width: 58ch;
        margin: 0 0 2rem;
        text-wrap: pretty;
      }
      .hero-cta {
        display: flex;
        gap: 1rem;
        justify-content: flex-start;
        flex-wrap: wrap;
      }
      .hero-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
        margin-top: 1.35rem;
      }
      .hero-meta-card {
        padding: 0.9rem 1rem;
        border-radius: 14px;
        background: rgba(255, 250, 243, 0.72);
        border: 1px solid rgba(196, 184, 168, 0.5);
      }
      .hero-meta-card strong {
        display: block;
        font-size: 0.78rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--color-accent-deep);
        margin-bottom: 0.2rem;
      }
      .hero-meta-card span {
        display: block;
        font-size: 0.9rem;
        color: var(--color-text-muted);
        line-height: 1.5;
      }
      .hero-visual {
        display: flex;
      }
      .hero-visual-card {
        width: 100%;
        overflow: hidden;
        border-radius: 22px;
        border: 1px solid rgba(196, 184, 168, 0.6);
        background: var(--color-surface-strong);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
      }
      .hero-visual-card img {
        width: 100%;
        height: 100%;
        min-height: 420px;
        object-fit: cover;
        display: block;
      }

      .section {
        padding: 3.5rem 0;
      }

      .content-band {
        background: #fff;
      }
      .statement-panel {
        border: 1px solid rgba(196, 184, 168, 0.7);
        border-radius: 24px;
        background: linear-gradient(135deg, rgba(255, 250, 243, 0.96), rgba(239, 228, 212, 0.78));
        padding: 2rem;
        box-shadow: 0 18px 42px rgba(62, 39, 35, 0.06);
      }
      .statement-panel p {
        color: var(--color-text-muted);
        max-width: 72ch;
        text-wrap: pretty;
      }
      .mini-card-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .mini-card {
        border: 1px solid rgba(196, 184, 168, 0.65);
        border-radius: 16px;
        background: rgba(255, 250, 243, 0.72);
        padding: 1rem;
      }
      .mini-card strong {
        display: block;
        margin-bottom: 0.35rem;
        color: var(--color-text);
      }
      .mini-card span,
      .mini-card p {
        color: var(--color-text-muted);
        font-size: 0.9rem;
        line-height: 1.65;
      }

      .product-detail-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 3rem;
        align-items: start;
      }
      .detail-section {
        margin-top: 2.25rem;
        padding: 1.5rem;
        border: 1px solid rgba(196, 184, 168, 0.68);
        border-radius: 18px;
        background: rgba(255, 250, 243, 0.72);
      }
      .detail-section h2,
      .detail-section h3 {
        font-family: var(--font-serif);
        color: var(--color-text);
      }
      .detail-section h2 {
        font-size: 1.45rem;
        margin-bottom: 0.75rem;
      }
      .detail-section h3 {
        font-size: 1.1rem;
        margin-bottom: 0.55rem;
      }
      .detail-section p {
        color: var(--color-text-muted);
        text-wrap: pretty;
      }
      .spec-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem;
        margin-top: 1rem;
      }
      .spec-item {
        padding: 0.9rem 1rem;
        border: 1px solid rgba(196, 184, 168, 0.55);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.42);
      }
      .spec-item strong {
        display: block;
        margin-bottom: 0.25rem;
        color: var(--color-accent-deep);
        font-size: 0.78rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .spec-item span {
        color: var(--color-text-muted);
        font-size: 0.92rem;
        line-height: 1.55;
      }
      .use-case-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
        margin-top: 1rem;
      }
      .use-case-card {
        border: 1px solid rgba(196, 184, 168, 0.58);
        border-radius: 14px;
        padding: 0.95rem;
        background: rgba(255, 255, 255, 0.42);
      }
      .use-case-card strong {
        display: block;
        margin-bottom: 0.3rem;
        color: var(--color-text);
      }
      .use-case-card span {
        color: var(--color-text-muted);
        font-size: 0.9rem;
        line-height: 1.6;
      }
      .order-list {
        counter-reset: order-step;
        list-style: none;
        padding: 0;
        margin-top: 1rem;
      }
      .order-list li {
        counter-increment: order-step;
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.75rem;
        align-items: start;
        padding: 0.75rem 0;
        color: var(--color-text-muted);
        border-top: 1px solid rgba(196, 184, 168, 0.45);
      }
      .order-list li::before {
        content: counter(order-step);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.55rem;
        height: 1.55rem;
        border-radius: 999px;
        background: var(--color-accent);
        color: #fff;
        font-size: 0.78rem;
        font-weight: 700;
      }
      .comparison-table {
        width: 100%;
        border-collapse: collapse;
        overflow: hidden;
        border-radius: 16px;
        border: 1px solid rgba(196, 184, 168, 0.68);
        background: rgba(255, 250, 243, 0.75);
      }
      .comparison-table th,
      .comparison-table td {
        padding: 0.9rem 1rem;
        text-align: left;
        border-bottom: 1px solid rgba(196, 184, 168, 0.52);
        vertical-align: top;
      }
      .comparison-table th {
        color: var(--color-accent-deep);
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background: rgba(230, 215, 196, 0.55);
      }
      .comparison-table td {
        color: var(--color-text-muted);
        font-size: 0.92rem;
      }
      .comparison-table tr:last-child td {
        border-bottom: 0;
      }
      .faq-list {
        display: grid;
        gap: 1rem;
      }
      .faq-item {
        padding: 1.15rem 1.25rem;
        border: 1px solid rgba(196, 184, 168, 0.65);
        border-radius: 16px;
        background: rgba(255, 250, 243, 0.72);
      }
      .faq-item h2 {
        font-family: var(--font-serif);
        font-size: 1.15rem;
        margin-bottom: 0.5rem;
      }
      .faq-item p {
        color: var(--color-text-muted);
        text-wrap: pretty;
      }


      .trust-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.25rem;
      }
      .trust-card {
        padding: 1.1rem 1rem;
        border: 1px solid rgba(196, 184, 168, 0.65);
        border-radius: 16px;
        background: rgba(255, 250, 243, 0.65);
      }
      .trust-card h3 {
        font-family: var(--font-serif);
        font-size: 1.15rem;
        margin-bottom: 0.55rem;
      }
      .trust-card p {
        color: var(--color-text-muted);
        font-size: 0.92rem;
        line-height: 1.65;
      }

      .prose {
        max-width: 760px;
      }
      .prose h2 {
        font-family: var(--font-serif);
        font-size: 1.6rem;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
      }
      .prose h3 {
        font-size: 1.15rem;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
      }
      .prose p {
        margin-bottom: 1rem;
        color: var(--color-text-muted);
      }
      .prose ul,
      .prose ol {
        margin-bottom: 1rem;
        padding-left: 1.5rem;
        color: var(--color-text-muted);
      }
      .prose li {
        margin-bottom: 0.35rem;
      }
      .prose strong {
        color: var(--color-text);
      }

      .feature-list {
        list-style: none;
        padding: 0;
      }
      .feature-list li {
        padding: 0.4rem 0;
        padding-left: 1.5rem;
        position: relative;
        color: var(--color-text-muted);
      }
      .feature-list li::before {
        content: '✓';
        position: absolute;
        left: 0;
        color: var(--color-accent);
        font-weight: 700;
      }

      @media (max-width: 720px) {
        .hero h1 {
          font-size: 2rem;
          max-width: none;
        }
        .site-header .container {
          align-items: flex-start;
          padding-top: 0.75rem;
          padding-bottom: 0.75rem;
          flex-direction: column;
        }
        .site-header-actions {
          justify-content: flex-start;
          gap: 0.7rem;
        }
        .site-nav {
          justify-content: flex-start;
          gap: 0.75rem;
        }
        .site-nav a {
          font-size: 0.8rem;
        }
        .section-title {
          font-size: 1.5rem;
        }
        .product-grid {
          grid-template-columns: 1fr;
        }
        .featured-grid,
        .hero-grid,
        .trust-grid,
        .hero-meta {
          grid-template-columns: 1fr;
        }
        .hero-surface {
          padding: 1.2rem;
          border-radius: 22px;
        }
        .hero-copy {
          text-align: left;
        }
        .hero-visual-card img {
          min-height: 260px;
        }

        .mini-card-grid,
        .product-detail-grid,
        .spec-grid,
        .use-case-grid {
          grid-template-columns: 1fr;
        }
        .detail-section,
        .statement-panel {
          padding: 1.1rem;
        }
        .product-card-img {
          height: 210px;
          padding: 0.85rem;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href={homeUrl} class="site-logo">{logoText} <span>{logoSubText}</span></a>
        <div class="site-header-actions">
          <nav class="site-nav" aria-label="Primary navigation">
            {navItems.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>
          {languageLinks.length > 0 && (
            <nav class="language-switcher" aria-label={lang === 'zh-CN' ? '语言切换' : 'Language switcher'}>
              {languageLinks.map((link) => (
                <a
                  href={link.href}
                  class={link.isActive ? 'active' : undefined}
                  aria-current={link.isActive ? 'page' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </nav>
          )}
          <a class="shop-link" href={siteLinks.taobao} target="_blank" rel="noopener noreferrer nofollow">
            {shopLinkLabel}
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-links">
          {footerLinks.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <a href="/contact">Contact</a>
          <a href={siteLinks.taobao} target="_blank" rel="noopener noreferrer nofollow">
            {shopLinkLabel}
          </a>
        </div>
        <div class="footer-copy">
          &copy; {new Date().getFullYear()} Yinshiji (Silver Food Records). All rights reserved.<br />
          <strong style="color:var(--color-text);">hello@tableorie.com</strong><br />
          <small>{footerNote}</small>
        </div>
      </div>
    </footer>
  </body>
</html>
